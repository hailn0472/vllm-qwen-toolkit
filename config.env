# =============================================================================
# Cấu hình chung của toolkit.
# Mọi giá trị đều có thể ghi đè bằng biến môi trường, ví dụ:
#   INSTALL_DIR=/data/llm bash install.sh
# Hoặc tạo file config.local.env (cùng thư mục) để ghi đè lâu dài (token, đường dẫn...).
# =============================================================================

# Thư mục cài đặt venv + model trên máy server.
# KHÔNG đặt trên USB (FAT32/exFAT/NTFS không hỗ trợ symlink, venv sẽ hỏng).
INSTALL_DIR="${INSTALL_DIR:-$HOME/vllm-qwen}"

# Profile model mặc định (xem thư mục profiles/). Đổi bằng: bash install.sh --profile <tên>
DEFAULT_PROFILE="${DEFAULT_PROFILE:-qwen3.5-4b}"

# Python cho venv. uv sẽ tự tải bản Python "managed", không đụng Python hệ thống
# (Ubuntu 26 có thể đi kèm Python mới hơn mức vLLM hỗ trợ).
PYTHON_VERSION="${PYTHON_VERSION:-3.12}"
SUPPORTED_PYTHON_MIN="3.10"
SUPPORTED_PYTHON_MAX="3.13"

# Phiên bản vLLM. Để trống = bản mới nhất trên PyPI. Ví dụ ghim: VLLM_VERSION=0.25.1
VLLM_VERSION="${VLLM_VERSION:-}"

# Backend PyTorch cho uv: auto (tự chọn theo driver), hoặc cu128, cu129, cu130...
TORCH_BACKEND="${TORCH_BACKEND:-auto}"

# Gói pip bổ sung muốn cài vào venv (cách nhau bởi dấu cách)
EXTRA_PIP_PACKAGES="${EXTRA_PIP_PACKAGES:-}"

# Yêu cầu tối thiểu
MIN_UV_VERSION="0.9.0"
MIN_DRIVER_VERSION="570"        # Blackwell (RTX PRO 6000) cần driver >= 570, dùng bản -open
MIN_DRIVER_CUDA_VERSION="12.8"  # CUDA mà driver hỗ trợ (dòng "CUDA Version" trong nvidia-smi)
MIN_RAM_GB=32
VENV_DISK_GB=20                 # dung lượng ước tính cho venv (torch + vllm + cache)

# OpenAI-compatible server
HOST="${HOST:-0.0.0.0}"
PORT="${PORT:-8000}"
API_KEY="${API_KEY:-}"          # để trống = không yêu cầu key

# Hugging Face
HF_TOKEN="${HF_TOKEN:-}"        # cần nếu model gated/private
HF_ENDPOINT="${HF_ENDPOINT:-}"  # mirror nếu cần, ví dụ https://hf-mirror.com

# LibreChat (web UI chạy bằng Docker, gọi vLLM qua OpenAI API)
LIBRECHAT_IMAGE="${LIBRECHAT_IMAGE:-ghcr.io/librechat-ai/librechat:v0.8.8}"
LIBRECHAT_PORT="${LIBRECHAT_PORT:-3080}"
LIBRECHAT_BIND="${LIBRECHAT_BIND:-0.0.0.0}"   # 127.0.0.1 = chỉ mở web trên máy này
LIBRECHAT_TITLE="${LIBRECHAT_TITLE:-Qwen Chat}"
LIBRECHAT_ALLOW_REGISTRATION="${LIBRECHAT_ALLOW_REGISTRATION:-true}"  # tắt sau khi đã tạo đủ tài khoản
