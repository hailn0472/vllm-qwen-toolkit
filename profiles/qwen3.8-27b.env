# Profile chính: Qwen3.8-27B BF16 (~55 GB weights). Vừa 1 card RTX PRO 6000 96 GB.
# Phần VRAM còn lại (~30 GB với util 0.90) dành cho KV cache.
MODEL_ID="Qwen/Qwen3.8-27B"
SERVED_MODEL_NAME="${SERVED_MODEL_NAME:-qwen3.8-27b}"

# Model hỗ trợ tới 262144 token; 32768 là mức an toàn cho 1 GPU. Tăng dần nếu cần.
MAX_MODEL_LEN="${MAX_MODEL_LEN:-32768}"
GPU_MEMORY_UTILIZATION="${GPU_MEMORY_UTILIZATION:-0.90}"
ENABLE_THINKING="${ENABLE_THINKING:-false}"

MIN_VRAM_GB=80
MIN_DISK_GB=60

EXTRA_SERVE_ARGS="${EXTRA_SERVE_ARGS:---reasoning-parser qwen3}"
