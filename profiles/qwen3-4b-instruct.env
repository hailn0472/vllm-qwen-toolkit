# Profile dự phòng: Qwen3-4B-Instruct-2507 (text-only, kiến trúc cũ, vLLM hỗ trợ ổn định từ lâu).
# Dùng khi bản vLLM đang cài chưa hỗ trợ kiến trúc Qwen3.5/3.8.
MODEL_ID="Qwen/Qwen3-4B-Instruct-2507"
SERVED_MODEL_NAME="${SERVED_MODEL_NAME:-qwen3-4b-instruct}"

MAX_MODEL_LEN="${MAX_MODEL_LEN:-32768}"
GPU_MEMORY_UTILIZATION="${GPU_MEMORY_UTILIZATION:-0.85}"
ENABLE_THINKING="${ENABLE_THINKING:-false}"   # model Instruct-2507 không có chế độ thinking

MIN_VRAM_GB=16
MIN_DISK_GB=10

EXTRA_SERVE_ARGS="${EXTRA_SERVE_ARGS:-}"
