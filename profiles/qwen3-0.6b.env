# Profile dự phòng siêu nhẹ: Qwen3-0.6B (~1.5 GB BF16, text-only, kiến trúc cũ vLLM hỗ trợ ổn định).
# Dùng khi bản vLLM đang cài chưa chạy được Qwen3.5-0.8B trên GPU nhỏ.
MODEL_ID="Qwen/Qwen3-0.6B"
SERVED_MODEL_NAME="${SERVED_MODEL_NAME:-qwen3-0.6b}"

MAX_MODEL_LEN="${MAX_MODEL_LEN:-8192}"
GPU_MEMORY_UTILIZATION="${GPU_MEMORY_UTILIZATION:-0.85}"
ENABLE_THINKING="${ENABLE_THINKING:-false}"
ENFORCE_EAGER="${ENFORCE_EAGER:-true}"

MIN_VRAM_GB=4
MIN_DISK_GB=4

MAX_NUM_SEQS="${MAX_NUM_SEQS:-16}"
MAX_NUM_BATCHED_TOKENS="${MAX_NUM_BATCHED_TOKENS:-2048}"

EXTRA_SERVE_ARGS="${EXTRA_SERVE_ARGS:---reasoning-parser qwen3}"
