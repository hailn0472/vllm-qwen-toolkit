# Profile siêu nhẹ: Qwen3.5-0.8B (~1.8 GB BF16). Dùng cho GPU nhỏ (4 GB, vd RTX 3050 laptop)
# để test toàn bộ quy trình vLLM + LibreChat trước khi lên server.
MODEL_ID="Qwen/Qwen3.5-0.8B"
SERVED_MODEL_NAME="${SERVED_MODEL_NAME:-qwen3.5-0.8b}"

MAX_MODEL_LEN="${MAX_MODEL_LEN:-8192}"
GPU_MEMORY_UTILIZATION="${GPU_MEMORY_UTILIZATION:-0.85}"
ENABLE_THINKING="${ENABLE_THINKING:-false}"

# Tiết kiệm VRAM (áp dụng cho cả serve.sh lẫn smoke test/test.sh):
ENFORCE_EAGER="${ENFORCE_EAGER:-true}"                    # tắt CUDA graph
LANGUAGE_MODEL_ONLY="${LANGUAGE_MODEL_ONLY:-true}"        # chỉ text: không nạp/profile vision encoder (ngốn ~1.5 GB khi khởi động)
MAX_NUM_SEQS="${MAX_NUM_SEQS:-16}"                        # số request song song tối đa
MAX_NUM_BATCHED_TOKENS="${MAX_NUM_BATCHED_TOKENS:-2048}"  # giảm bộ nhớ activation lúc prefill

MIN_VRAM_GB=4
MIN_DISK_GB=4

EXTRA_SERVE_ARGS="${EXTRA_SERVE_ARGS:---reasoning-parser qwen3}"
