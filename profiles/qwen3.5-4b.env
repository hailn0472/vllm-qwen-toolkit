# Profile test nhẹ: Qwen3.5-4B (~9 GB BF16). Dùng để kiểm tra toolkit trước khi lên 27B.
MODEL_ID="Qwen/Qwen3.5-4B"
SERVED_MODEL_NAME="${SERVED_MODEL_NAME:-qwen3.5-4b}"

MAX_MODEL_LEN="${MAX_MODEL_LEN:-32768}"
GPU_MEMORY_UTILIZATION="${GPU_MEMORY_UTILIZATION:-0.85}"
ENABLE_THINKING="${ENABLE_THINKING:-false}"

MIN_VRAM_GB=16
MIN_DISK_GB=15

# Tham số thêm cho `vllm serve`
EXTRA_SERVE_ARGS="${EXTRA_SERVE_ARGS:---reasoning-parser qwen3}"
